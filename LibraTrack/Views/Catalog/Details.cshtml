@* The controller sends ONE Book (with Category and Copies loaded) *@
@model LibraTrack.Models.Book
@{
    ViewData["Title"] = Model.Title;
}

<h1>@Model.Title</h1>
<p class="text-muted">by @Model.Author | @Model.Category?.Name</p>
@{  var avail = Model.GetAvailability(); }
<p><span class="badge fs-6 @avail.Level.BadgeClass()">@avail.Message()</span></p>

<dl class="row">
    <dt class="col-sm-3">ISBN</dt>
    <dd class="col-sm-9">@Model.ISBN</dd>

    <dt class="col-sm-3">Publisher</dt>
    <dd class="col-sm-9">@(Model.Publisher ?? "N/A")</dd>   @* nullable field: show N/A *@

    <dt class="col-sm-3">Year</dt>
    <dd class="col-sm-9">@(Model.PublicationYear?.ToString() ?? "N/A")</dd>
</dl>

<h5>Copies</h5>
<table class="table table-sm">
    <thead><tr><th>Barcode</th><th>Branch</th><th>Status</th></tr></thead>
    <tbody>
        @foreach (var c in Model.Copies)
        {
            <tr>
                <td>@c.Barcode</td>
                <td>@c.Branch</td>
                @* NEW: per-copy badge. c.Status is the text (Available/Reserved/Borrowed), the color comes from the copy's level *@
                <td><span class="badge @c.GetAvailability().BadgeClass()">@c.Status</span></td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Back to catalog</a>